generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  password    String
  role        Role         @default(STUDENT)
  division    String?      // الشعبة
  classNumber String?      // رقم الكشف
  image       String?
  attendance  Attendance[]

  personalTasks PersonalTask[]
}

model Subject {
  id         String    @id @default(uuid())
  name       String
  code       String?
  term       String
  isElective Boolean   @default(false)
  hasSection Boolean   @default(false)
  hasLecture Boolean   @default(true)
  lectures   Lecture[]
}

model Lecture {
  id        String      @id @default(uuid())
  topic     String
  type      LectureType @default(PHYSICAL)
  date      DateTime    @default(now())
  qrCode    String      @default("")
  
  lat       Float?
  lng       Float?
  
  // 🔥 الحقل الجديد: لتخزين الشعب المسموح لها (نص مفصول بفاصلة مثل "1,3")
  allowedDivisions String? 
  
  isActive         Boolean  @default(true)
  subjectId String?
  subject   Subject?    @relation(fields: [subjectId], references: [id])
  attendance Attendance[]
}

model Attendance {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  lecture   Lecture  @relation(fields: [lectureId], references: [id])
  lectureId String
  scanTime  DateTime @default(now())
  status    Status   @default(PRESENT)

  @@unique([userId, lectureId])
}
model PersonalTask {
  id        String   @id @default(uuid())
  title     String
  isDone    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model GlobalTask {
  id        String   @id @default(uuid())
  title     String
  link      String?
  image     String?
  category  String   @default("NEWS") // 🔥 "NEWS" or "TASK"
  createdAt DateTime @default(now())
}
enum Role {
  ADMIN
  STUDENT
}

enum Status {
  PRESENT
  ABSENT
}

enum LectureType {
  PHYSICAL
  ONLINE
  SECTION
}
